# aus_yolo_mlops - pipeline environment
# KEY=VALUE, "#" comments. Loaded automatically by src/config.py BEFORE CELL 2
# applies its AUS_* overrides, and every variable already present in the shell
# (or in docker-compose.yml) wins over this file.
#
# Run every command from the project root so relative paths resolve here.

# --- working directory: replaces the Colab /content/drive/MyDrive/aus_seg ----
# Shared inputs/outputs of the notebook live here (data/, yolo/, runs/, onnx/,
# splits/, checkpoints/, logs/) - same layout as the Colab run.
AUS_WORK_DIR=work

# no Google Drive when running locally or in a container
AUS_MOUNT_DRIVE=0

# run profile: "custom" (CONFIG as-is), "quick" (smoke test) or "full"
AUS_PROFILE=custom

# --- MLflow tracking ---------------------------------------------------------
MLOPS_MLFLOW_ENABLED=1
MLOPS_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLOPS_MLFLOW_EXPERIMENT=australia_building_footprints

# --- MinIO: RUN OUTPUTS ONLY (inputs are downloaded inside the stages) -------
MLOPS_MINIO_ENABLED=1
MLOPS_MINIO_ENDPOINT=http://127.0.0.1:9000
MLOPS_MINIO_ACCESS_KEY=minioadmin
MLOPS_MINIO_SECRET_KEY=minioadmin
MLOPS_MINIO_BUCKET=aus-yolo-mlops
MLOPS_MINIO_SECURE=0

# --- optional: lon/lat bbox for the predict_area stage (xmin,ymin,xmax,ymax) -
#MLOPS_PREDICT_BBOX=151.20,-33.88,151.23,-33.86
